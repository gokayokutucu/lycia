<Project>
  <PropertyGroup><TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>preview</LangVersion></PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Shared.Contracts'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Shared.Contracts/Shared.Contracts.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Lycia\Lycia.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Lycia.Extensions\Lycia.Extensions.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Lycia.Extensions.RabbitMq\Lycia.Extensions.RabbitMq.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Lycia.Persistence.PostgreSql\Lycia.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Lycia.Persistence.Redis\Lycia.Persistence.Redis.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Shared.Contracts'">
    <Compile Include="$(MSBuildThisFileDirectory)ServiceBootstrap.cs" Link="ServiceBootstrap.cs" />
  </ItemGroup>
</Project>
